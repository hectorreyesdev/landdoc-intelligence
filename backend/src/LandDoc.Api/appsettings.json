{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModelClient": {
    "ChatProvider": "azureopenai",
    "EmbeddingProvider": "azureopenai"
  },
  "VectorStore": {
    "Provider": "azuresearch"
  },
  "DocumentStore": {
    "Provider": "azureblob"
  },
  "UsageSource": {
    "Provider": "azuremonitor"
  },
  "Monitor": {
    "ResourceId": ""
  },
  "Pricing": {
    "gpt-5.4-mini": { "InputPer1K": 0.00015, "OutputPer1K": 0.0006 },
    "text-embedding-3-small": { "InputPer1K": 0.00002, "OutputPer1K": 0 }
  },
  "AzureOpenAI": {
    "Deployment": "gpt-5.4-mini",
    "EmbeddingDeployment": "text-embedding-3-small"
