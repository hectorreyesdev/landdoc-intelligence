{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ModelClient": {
    "ChatProvider": "azureopenai",
    "EmbeddingProvider": "local"
  },
  "AzureOpenAI": {
    "Deployment": "gpt-5.4-mini"
  },
  "Anthropic": {
    "Model": "claude-opus-4-8"
  },
  "Embedding": {
    "Dimension": 256
  },
  "Chunking": {
    "MaxChars": 120,
    "Overlap": 30
  },
  "Retrieval": {
    "TopK": 5
  }
}
